---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for item in site.pages %}{% unless item.sitemap == false or item.url contains '/assets/' or item.url == '/sitemap.xml' or item.url == '/feed.xml' or item.url == '/robots.txt' or item.url == '/llms.txt' %}
  <url>
    <loc>{{ item.url | absolute_url | xml_escape }}</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <changefreq>{% if item.url == '/' or item.url == '/blog.html' %}daily{% else %}monthly{% endif %}</changefreq>
    <priority>{% if item.url == '/' %}1.0{% elsif item.url == '/blog.html' %}0.9{% else %}0.7{% endif %}</priority>
  </url>
{% endunless %}{% endfor %}
{% for post in site.posts %}
  <url>
    <loc>{{ post.url | absolute_url | xml_escape }}</loc>
    <lastmod>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
{% endfor %}
</urlset>
